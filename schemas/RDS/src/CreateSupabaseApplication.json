{"base_path":"/","components":null,"consumes":"[\"application/json\"]","definitions":{"ChargeInfo":{"description":"计费类型信息,支持包年包月和按需,默认为按需。","properties":{"charge_mode":{"description":"计费模式。\n\n取值范围:\n\n- prePaid:预付费,即包年/包月。\n- postPaid:后付费,即按需付费。","enum":["prePaid","postPaid"],"type":"string"},"is_auto_pay":{"description":"创建包周期时可指定,表示是否自动从客户的账户中支付,此字段不影响自动续订的支付方式。\n\n- true,为自动支付。\n- false,为手动支付,默认该方式。","enum":[true,false],"type":"boolean"},"is_auto_renew":{"description":"创建包周期实例时可指定,表示是否自动续订,续订的周期和原周期相同,且续订时会自动支付。\n\n- true,为自动续订。\n- false,为不自动续订,默认该方式。","enum":[true,false],"type":"boolean"},"period_num":{"description":"“charge_mode”为“prePaid”时生效,且为必选值,指定订购的时间。\n\n取值范围:\n\n当“period_type”为“month”时,取值为1~9。\n当“period_type”为“year”时,取值为1~3。","type":"integer"},"period_type":{"description":"订购周期类型。\n\n取值范围:\n\n- month:包月。\n- year:包年。","enum":["month","year"],"type":"string"}},"required":["charge_mode"]},"CreateSupabaseApplicationRequestBody":{"description":"创建Supabase应用请求体。","properties":{"availability_zone":{"description":"可用区ID。Single=1个,Ha=2个逗号分隔。","type":"string"},"basic_config":{"$ref":"#/definitions/SupabaseAppBasicConfig"},"data_vip":{"description":"指定实例内网IP(可选)。IPv4格式。","type":"string"},"existing_instance":{"$ref":"#/definitions/SupabaseExistingInstanceRequest","description":"存量PG实例配置(manage_type=existed_instance时必填,newly_instance时必须为null)。"},"flavor_ref":{"description":"规格码,格式 rds.supabase.{...}。Ha模式必须以.ha结尾,Single不得以.ha结尾。","pattern":"^rds.supabase(.[a-z0-9]+){3,4}$","type":"string"},"manage_type":{"default":"newly_instance","description":"实例纳管方式。默认newly_instance。","enum":["newly_instance","existed_instance"],"type":"string"},"managed_instance":{"$ref":"#/definitions/SupabaseInstanceCreateRequest","description":"新建托管PG实例配置(manage_type=newly_instance时必填,existed_instance时必须为null)。"},"mode":{"description":"部署模式。","enum":["Single","Ha"],"type":"string"},"name":{"description":"Supabase应用名称,4~64个字符。","maxLength":64,"minLength":4,"type":"string"},"password":{"description":"默认用户supabase的密码。","type":"string"},"security_group_id":{"description":"指定实例所属安全组(可选)。UUID格式。","type":"string"},"storage_component":{"$ref":"#/definitions/SupabaseStorageComponentConfig"},"version":{"description":"Supabase版本号,格式 x.y.z。","pattern":"^[1-9]\\d*\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$","type":"string"}},"required":["name","basic_config","version","mode","flavor_ref","availability_zone","password","storage_component"]},"CreateSupabaseApplicationResponseBody":{"description":"创建Supabase应用响应体。","properties":{"application_id":{"description":"Supabase应用ID。","type":"string"},"instance_id":{"description":"数据库实例ID。","type":"string"},"instance_job_id":{"description":"实例创建任务ID。","type":"string"},"job_id":{"description":"应用创建任务ID。","type":"string"},"order_id":{"description":"订单ID(包周期时返回)。","type":"string"}}},"SupabaseAppBasicConfig":{"description":"应用基础配置。","properties":{"region":{"description":"区域ID。","type":"string"},"subnet_id":{"description":"子网网络ID。","type":"string"},"time_zone":{"description":"UTC时区(可选)。","type":"string"},"vpc_id":{"description":"虚拟私有云ID。","type":"string"}},"required":["region","vpc_id","subnet_id"]},"SupabaseDatastore":{"description":"数据库信息。","properties":{"type":{"description":"数据库引擎。","enum":["PostgreSQL"],"type":"string"},"version":{"description":"数据库版本。","type":"string"}},"required":["type","version"]},"SupabaseExistingInstanceRequest":{"description":"存量PG实例请求(manage_type=existed_instance时必填)。","properties":{"database_name":{"description":"对接的数据库用户名。","type":"string"},"database_pwd":{"description":"对接的数据库密码。","type":"string"},"instance_id":{"description":"数据库实例ID(必须为PostgreSQL实例)。","type":"string"}},"required":["instance_id","database_name","database_pwd"]},"SupabaseHaConfig":{"description":"HA配置。","properties":{"mode":{"enum":["Ha","Single"],"type":"string"},"replication_mode":{"enum":["async","sync"],"type":"string"}}},"SupabaseInstanceCreateRequest":{"description":"新建托管PG实例请求(manage_type=newly_instance时必填)。","properties":{"availability_zone":{"description":"可用区,≤2个逗号分隔,首个=顶层主AZ。","type":"string"},"charge_info":{"$ref":"#/definitions/ChargeInfo","description":"复用现有ChargeInfo定义。"},"configuration_id":{"description":"参数模板ID(可选)。","type":"string"},"data_vip":{"description":"内网IP(可选)。","type":"string"},"datastore":{"$ref":"#/definitions/SupabaseDatastore"},"enterprise_project_id":{"description":"企业项目ID。","type":"string"},"flavor_ref":{"description":"PG实例规格码。","type":"string"},"ha":{"$ref":"#/definitions/SupabaseHaConfig"},"password":{"description":"数据库密码。","type":"string"},"port":{"default":5432,"description":"数据库端口,2100~9500,默认5432。","maximum":9500,"minimum":2100,"type":"integer"},"security_group_id":{"description":"安全组ID。","type":"string"},"tags":{"description":"标签列表,最多20个。","items":{"$ref":"#/definitions/TagWithKeyValue"},"maxItems":20,"type":"array"},"volume":{"$ref":"#/definitions/SupabaseVolumeConfig"}},"required":["datastore","charge_info","flavor_ref","volume","availability_zone","ha","security_group_id","password","enterprise_project_id"]},"SupabaseStorageComponentConfig":{"description":"Supabase Storage存储组件对接配置。","properties":{"ak":{"description":"访问密钥ID,1~32字符。enabled=true时必填。","pattern":"^[a-zA-Z0-9_-]{1,32}$","type":"string"},"bucket_name":{"description":"桶名称,3~64字符。enabled=true时必填。","pattern":"^[a-zA-Z0-9.\\-]{3,64}$","type":"string"},"enabled":{"description":"是否启用Storage组件。enabled=false时bucket_name/ak/sk必须全空;enabled=true时全必填。","type":"boolean"},"sk":{"description":"秘密访问密钥,1~64字符。enabled=true时必填。","pattern":"^[a-zA-Z0-9_-]{1,64}$","type":"string"},"type":{"description":"对象存储类型。","enum":["obs"],"type":"string"}},"required":["enabled"]},"SupabaseVolumeConfig":{"description":"存储配置。","properties":{"size":{"description":"磁盘大小(GB)。","type":"integer"},"type":{"description":"磁盘类型。","enum":["CLOUDSSD"],"type":"string"}}},"TagWithKeyValue":{"description":"键值对标签。","properties":{"key":{"description":"标签键。长度为1-128个unicode字符。\n可以包含任何语种字母、数字、空格和_.:=+-@,\n但首尾不能含有空格,不能以sys开头。","type":"string"},"value":{"description":"标签值。最大长度255个unicode字符。\n可以为空字符串。可以包含任何语种字母、数字、空格和_.:=+-@,","type":"string"}},"required":["key","value"]}},"description":null,"group_id":"b7735f867ef44182af9eb77490a46fbf","host":"rds.cn-north-4.myhuaweicloud.com","id":"ddc18a4768cc451584b427cd0364a3b9","info_version":"v3","method":"post","name":"CreateSupabaseApplication","parameters":{},"paths":{"/v3/{project_id}/ai-application/supabases":{"post":{"description":"创建Supabase应用。支持两类路径:\n1) 同时创建托管的PostgreSQL实例(manage_type=newly_instance);\n2) 关联已有PostgreSQL实例(manage_type=existed_instance)。\n异步接口,返回job_id(按需)或order_id(包周期)。","operationId":"CreateSupabaseApplication","parameters":[{"description":"用户Token。","in":"header","name":"x-auth-token","type":"string","x-example":"******"},{"description":"语言","enum":["zh-cn","en-us"],"in":"header","name":"X-Language","type":"string"},{"description":"保证客户端请求幂等性的标识。32位UUID格式,72小时内唯一。","in":"header","name":"X-Client-Token","type":"string"},{"description":"项目ID。","in":"path","name":"project_id","required":true,"type":"string"},{"description":"请求体。","in":"body","name":"CreateSupabaseApplicationRequestBody","required":true,"schema":{"$ref":"#/definitions/CreateSupabaseApplicationRequestBody"}}],"responses":{"202":{"description":"Accepted.","examples":{"application/json":{"application_id":"3a1f7fc8-3307-42a7-aa6f-42c8b9b8f8c5","instance_id":"490a4a08-ef4b-44c5-94be-3051ef9e4fce","instance_job_id":"0e2eda62-1d42-4d64-a9d1-4e9aa9cd994f","job_id":"dff1d289-4d03-4942-8b9f-463ea07c000d","order_id":""}},"schema":{"$ref":"#/definitions/CreateSupabaseApplicationResponseBody"}}},"summary":"创建Supabase应用","tags":["Supabase应用管理"],"x-constraint":"- storage_component:enabled=false时bucket_name/ak/sk必须全空;enabled=true时全必填。\n- flavor_ref与mode:Single不得以.ha结尾;Ha必须以.ha结尾且规格存在。\n- availability_zone:Single=1个,Ha=2个逗号分隔。\n- manage_type二选一:existed_instance时managed_instance必须为null;newly_instance时existing_instance必须为null。\n- 规格必须在免费规格范围内。","x-support-sdk":"Y"}}},"product_short":"RDS","region_id":"cn-nor