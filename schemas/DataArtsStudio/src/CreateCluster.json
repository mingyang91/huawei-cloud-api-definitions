{"base_path":"/","components":null,"consumes":"[\"application/json;charset=UTF-8\"]","definitions":{"CreateClusterReq":{"description":"创建集群的请求参数。","properties":{"charge_mode":{"description":"集群的收费模式。只能设置为“1”,表示按照CU时收费。","example":1,"format":"int32","type":"integer"},"cidr_in_vpc":{"default":"172.16.0.0/18","description":"队列的虚拟私有云(VPC)的网段。建议使用网段:10.0.0.0/8~28,172.16.0.0/12~28,192.168.0.0/16~28。","example":"10.0.0.0/8","pattern":"^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$","type":"string"},"cluster_name":{"description":"新建的集群名称,名称只能包含数字、英文字母和下划线,但不能是纯数字,且不能以下划线开头。长度限制:1~128个字符。\n说明:集群名称不区分大小写,系统会自动转换为小写。","example":"cluster1","maxLength":128,"minLength":1,"pattern":"^(?![0-9]+$)(?![a-z]+$)[a-z0-9][a-z0-9_]{1,128}$","type":"string"},"description":{"description":"集群的描述信息。","example":"test","maxLength":128,"type":"string"},"flavor_id":{"description":"集群规格。","example":"26afb850-d3c9-42c1-81c0-583d1163e80f","maxLength":64,"pattern":"^[a-zA-Z0-9\\-]+$","type":"string"},"workspaces":{"description":"集群需要绑定的工作空间ID。","items":{"maxLength":128,"type":"string"},"maxItems":100,"type":"array"}},"required":["cluster_name","flavor_id","charge_mode"],"type":"object"},"CreateClusterResp":{"description":"创建集群的响应参数。","properties":{"cluster_name":{"description":"新增集群的名称。","example":"cluster1","type":"string"},"is_success":{"description":"请求执行是否成功。\"true\"表示请求执行成功。","example":true,"type":"boolean"},"job_id":{"description":"异步作业id,用于查询作业状态。","example":"job_id","type":"string"},"message":{"description":"系统提示信息,执行成功时,信息可能为空。","example":"","type":"string"}},"type":"object"},"ErrorRsp":{"description":"失败时返回的错误对象","properties":{"error_code":{"description":"错误码","maxLength":36,"minLength":8,"type":"string"},"error_msg":{"description":"错误描述","maxLength":512,"minLength":2,"type":"string"}},"required":["error_code","error_msg"]}},"description":null,"group_id":"23bb69798aaf409da161a43a90617121","host":"dayu.cn-north-4.myhuaweicloud.com","id":"ab02db56f03247c2b78953d6cb975fd6","info_version":"v1","metho