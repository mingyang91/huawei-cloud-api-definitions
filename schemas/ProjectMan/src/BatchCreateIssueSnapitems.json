{"base_path":"/","components":null,"consumes":"[\"application/json;charset=UTF-8\"]","definitions":{"BatchCreateSnapshotRequest":{"description":"批量创建工作项快照请求对象","properties":{"issues":{"description":"需要创建快照的工作项数组。 每次最多支持对50个工作项创建快照。","items":{"properties":{"id":{"description":"工作项ID。可以通过查询工作项列表或者查询树状工作项接口获取,响应消息体中的id字段的值就是工作项ID。 18~19个字符的数字字符串。","type":"string"}},"required":["id"]},"type":"array"}},"required":["issues"],"type":"object"},"BatchCreateSnapshotResponse":{"description":"批量创建快照的响应","properties":{"message":{"description":"失败原因。","type":"string"},"result":{"description":"批量创建快照的结果。","properties":{"failed":{"description":"创建失败的快照列表。","items":{"$ref":"#/definitions/CreateSnapshotResult"},"type":"array"},"success":{"description":"创建成功的快照列表。","items":{"$ref":"#/definitions/CreateSnapshotResult"},"type":"array"}},"type":"object"},"status":{"description":"返回状态。","type":"string"}},"type":"object"},"CreateSnapshotResult":{"description":"创建快照的结果","properties":{"category":{"description":"快照类型。工作项快照固定为:issue_snap_item。","example":"issue_snap_item","type":"string"},"created_by":{"description":"快照的创建人ID。","example":"c533da3e53244b589e7175bb766859ac","type":"string"},"deletable":{"description":"快照是否可被删除。","example":true,"type":"boolean"},"errormsg":{"description":"创建快照失败的原因。","type":"string"},"id":{"description":"快照ID。","example":"1243589930102018048","type":"string"},"issue_id":{"description":"快照的工作项ID。","example":"1222557368042950656","type":"string"},"title":{"description":"快照名称。创建时自动生成,工作项快照名称生成规则为:“工作项类型”+“ v” + “年”+“.”+“月”+“.”+“日”+“.”+“当日生成版本次数”。例如工作项类型为IR的工作项在2026年3月25日第一次打快照系统生成的快照名称为:IR v26.03.25.1。","example":"SR v26.03.25.1","type":"string"}},"type":"object"}},"description":null,"group_id":"986b06428ba54ab7a1b0a2cac7203d2a","host":"projectman-ext.cn-north-4.myhuaweicloud.com","id":"1fe1d8188b2540fd8b16233f34da7bd3","info_version":"v4","method":"post","name":"BatchCreateIssueSnapitems","parameters":{"X-Auth-Token":{"description":"用户Token。通过调用IAM服务获取用户Token接口获取(响